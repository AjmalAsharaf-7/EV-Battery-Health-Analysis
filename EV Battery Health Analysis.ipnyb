  {
   "cell_type": "markdown",
   "id": "d63cd776-cf2d-49f5-b56e-27176d8e6ba7",
   "metadata": {},
   "source": [
    "## 11.20 Detecting Outliers\n",
    "\n",
    "Outliers are values that differ significantly from the other observations in a dataset. In this step, we use the Interquartile Range (IQR) method to identify potential outliers in numerical columns."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 64,
   "id": "150aaee5-0c1c-4333-b934-a74b369cf143",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Numerical Columns:\n",
      "['pack_capacity_kwh', 'battery_age_days', 'cycle_count', 'avg_daily_distance_km', 'avg_charging_power_kw', 'fast_charge_ratio', 'avg_depth_of_discharge_pct', 'avg_state_of_charge_pct', 'charge_cycles_per_month', 'total_energy_throughput_kwh', 'avg_ambient_temp_c', 'humidity_pct', 'altitude_m', 'internal_resistance_mohm', 'voltage_avg_v', 'current_avg_a', 'charge_time_avg_min', 'peak_temp_during_fast_charge_c', 'capacity_fade_pct', 'service_count', 'recall_flag', 'state_of_health_pct', 'remaining_useful_life_cycles']\n"
     ]
    }
   ],
   "source": [
    "# Select numerical columns\n",
    "numerical_columns = df.select_dtypes(include=['int64', 'float64']).columns\n",
    "\n",
    "print(\"Numerical Columns:\")\n",
    "print(list(numerical_columns))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 65,
   "id": "1b469de2-abf9-4dcc-a5d6-3ade4f5984d9",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "pack_capacity_kwh: 0 outliers\n",
      "battery_age_days: 560 outliers\n",
      "cycle_count: 2400 outliers\n",
      "avg_daily_distance_km: 2205 outliers\n",
      "avg_charging_power_kw: 1136 outliers\n",
      "fast_charge_ratio: 285 outliers\n",
      "avg_depth_of_discharge_pct: 142 outliers\n",
      "avg_state_of_charge_pct: 153 outliers\n",
      "charge_cycles_per_month: 432 outliers\n",
      "total_energy_throughput_kwh: 2566 outliers\n",
      "avg_ambient_temp_c: 219 outliers\n",
      "humidity_pct: 164 outliers\n",
      "altitude_m: 2271 outliers\n",
      "internal_resistance_mohm: 2573 outliers\n",
      "voltage_avg_v: 59 outliers\n",
      "current_avg_a: 694 outliers\n",
      "charge_time_avg_min: 3292 outliers\n",
      "peak_temp_during_fast_charge_c: 200 outliers\n",
      "capacity_fade_pct: 2307 outliers\n",
      "service_count: 1520 outliers\n",
      "recall_flag: 721 outliers\n",
      "state_of_health_pct: 2410 outliers\n",
      "remaining_useful_life_cycles: 118 outliers\n"
     ]
    }
   ],
   "source": [
    "# Detect outliers using the IQR method\n",
    "\n",
    "for col in numerical_columns:\n",
    "    Q1 = df[col].quantile(0.25)\n",
    "    Q3 = df[col].quantile(0.75)\n",
    "\n",
    "    IQR = Q3 - Q1\n",
    "\n",
    "    lower_limit = Q1 - 1.5 * IQR\n",
    "    upper_limit = Q3 + 1.5 * IQR\n",
    "\n",
    "    outliers = df[\n",
    "        (df[col] < lower_limit) |\n",
    "        (df[col] > upper_limit)\n",
    "    ]\n",
    "\n",
    "    print(f\"{col}: {len(outliers)} outliers\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "2080923a-accf-47fe-b58e-482f0f2f75a2",
   "metadata": {},
   "source": [
