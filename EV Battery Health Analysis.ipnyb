    "# Calculate battery age using date columns\n",
    "\n",
    "df['calculated_battery_age_days'] = (\n",
    "    df['observation_date'] - df['manufacture_date']\n",
    ").dt.days\n",
    "\n",
    "df[['battery_age_days', 'calculated_battery_age_days']].head(10)"
   ]
