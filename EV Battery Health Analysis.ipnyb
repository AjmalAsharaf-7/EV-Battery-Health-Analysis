       "5                fast_charge_ratio            285                0.57\n",
       "10              avg_ambient_temp_c            219                0.44\n",
       "17  peak_temp_during_fast_charge_c            200                0.40\n",
       "11                    humidity_pct            164                0.33\n",
       "7          avg_state_of_charge_pct            153                0.31\n",
       "6       avg_depth_of_discharge_pct            142                0.28\n",
       "22    remaining_useful_life_cycles            118                0.24\n",
       "14                   voltage_avg_v             59                0.12\n",
       "0                pack_capacity_kwh              0                0.00"
      ]
     },
     "execution_count": 66,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "# Calculate outlier percentage for each numerical column\n",
    "\n",
    "outlier_summary = []\n",
    "\n",
    "for col in numerical_columns:\n",
    "    Q1 = df[col].quantile(0.25)\n",
    "    Q3 = df[col].quantile(0.75)\n",
    "\n",
    "    IQR = Q3 - Q1\n",
    "\n",
    "    lower_limit = Q1 - 1.5 * IQR\n",
    "    upper_limit = Q3 + 1.5 * IQR\n",
    "\n",
    "    outlier_count = (\n",
    "        (df[col] < lower_limit) |\n",
    "        (df[col] > upper_limit)\n",
    "    ).sum()\n",
    "\n",
    "    outlier_percentage = (outlier_count / len(df)) * 100\n",
    "\n",
    "    outlier_summary.append({\n",
    "        'Column': col,\n",
    "        'Outlier Count': outlier_count,\n",
    "        'Outlier Percentage': round(outlier_percentage, 2)\n",
    "    })\n",
    "\n",
    "outlier_df = pd.DataFrame(outlier_summary)\n",
    "\n",
    "outlier_df.sort_values(\n",
    "    by='Outlier Percentage',\n",
    "    ascending=False\n",
    ")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "fcfab30d-9b03-4695-b2c3-63cd21cbcd8f",
   "metadata": {},
   "source": [
