     "execution_count": 75,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "# Calculate temperature difference\n",
    "\n",
    "df['temperature_difference'] = (\n",
    "    df['peak_temp_during_fast_charge_c'] -\n",
    "    df['avg_ambient_temp_c']\n",
    ")\n",
    "\n",
    "df['temperature_difference'].describe()"
   ]
